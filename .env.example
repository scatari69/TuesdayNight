DISCORD_TOKEN=replace_me
# Для быстрой регистрации команд на одном тестовом сервере; иначе глобальные команды.
DISCORD_GUILD_ID=
TZ=Europe/Kyiv
# Веб-панель выключена, пока WEB_BASE_URL пустой. Домен указывается без завершающего /.
WEB_BASE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Для Nginx Proxy Manager на другом хосте укажите LAN-адрес Docker-хоста.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
